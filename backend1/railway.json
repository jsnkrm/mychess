{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksJson": {
      "name": "mychess-backend",
      "install": {
        "commands": "npm install --include=dev && npx prisma generate"
      },
      "build": {
        "command": "npm run build"
      },
      "start": {
        "command": "npm run start"
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
