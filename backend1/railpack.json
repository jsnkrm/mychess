{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm install --include=dev"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npx prisma generate",
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npx prisma migrate deploy && npm run start"
  }
}
